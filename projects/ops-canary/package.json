{
  "name": "ops-canary",
  "version": "0.1.0",
  "description": "Payload-free heartbeat monitoring for missing, late, and duplicate automations",
  "type": "module",
  "bin": {
    "ops-canary": "./bin/ops-canary.js"
  },
  "scripts": {
    "start": "node ./bin/ops-canary.js serve",
    "check": "node --check ./bin/ops-canary.js && node --check ./src/cli.js && node --check ./src/db.js && node --check ./src/model.js && node --check ./src/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "keywords": [
    "automation",
    "heartbeat",
    "monitoring",
    "n8n",
    "zapier",
    "make"
  ]
}
